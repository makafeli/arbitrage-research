FROM rust:1.90.0-bookworm AS build
WORKDIR /src
COPY . .
RUN cargo build --locked --release -p control-api -p research-worker

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 10001 --create-home arb
WORKDIR /app
COPY --from=build /src/target/release/control-api /usr/local/bin/control-api
COPY config/research.example.toml /app/config/research.example.toml
COPY config/owner-bootstrap.json /app/config/owner-bootstrap.json
USER 10001:10001
ENV ARB_API_BIND_IP=:: ARB_API_PORT=8080
EXPOSE 8080
ENTRYPOINT ["control-api"]
