FROM rust:1.90.0-bookworm AS build
WORKDIR /src
COPY . .
RUN cargo build --locked --release -p control-api -p research-worker

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates gosu \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 10001 --create-home arb
WORKDIR /app
COPY --from=build /src/target/release/research-worker /usr/local/bin/research-worker
COPY deploy/worker-entrypoint.sh /usr/local/bin/worker-entrypoint
RUN chmod 755 /usr/local/bin/worker-entrypoint
ENTRYPOINT ["worker-entrypoint"]
CMD ["research-worker"]
