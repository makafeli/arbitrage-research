{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arbitrage-research:opportunity:1.1.0",
  "title": "Opportunity evidence record",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "enum": [
        "1.0.0",
        "1.1.0"
      ]
    },
    "source_kind": {
      "enum": [
        "SYNTHETIC_FIXTURE",
        "CAPTURED_MARKET_DATA"
      ]
    },
    "opportunity_id": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "experiment_id": {
      "type": "string"
    },
    "strategy_revision": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "network_id": {
      "type": "string",
      "enum": [
        "base-mainnet",
        "solana-mainnet"
      ]
    },
    "mode": {
      "type": "string",
      "enum": [
        "OBSERVE",
        "PAPER",
        "REPLAY",
        "LIVE"
      ]
    },
    "evidence_label": {
      "type": "string",
      "enum": [
        "CANDIDATE",
        "SIMULATED",
        "ESTIMATED_EXECUTABLE",
        "REALIZED"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "snapshot_id": {
          "type": "string"
        },
        "state_reference": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "consistent": {
          "type": "boolean"
        },
        "complete": {
          "type": "boolean"
        },
        "finality_label": {
          "type": "string"
        },
        "age_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "snapshot_id",
        "state_reference",
        "source",
        "consistent",
        "complete",
        "finality_label",
        "age_ms"
      ]
    },
    "funding_mode": {
      "enum": [
        "OWN_CAPITAL",
        "FLASH_LOAN"
      ]
    },
    "start_asset_id": {
      "type": "string"
    },
    "amount_in_minor": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "quoted_output_minor": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "route": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "pool_id": {
            "type": "string",
            "minLength": 1
          },
          "venue_family": {
            "type": "string"
          },
          "asset_in": {
            "type": "string"
          },
          "asset_out": {
            "type": "string"
          }
        },
        "required": [
          "pool_id",
          "venue_family",
          "asset_in",
          "asset_out"
        ]
      }
    },
    "costs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "NETWORK_FEE",
              "PRIORITY_FEE",
              "RELAY_TIP",
              "BORROW_FEE",
              "ACCOUNT_SETUP",
              "OTHER_EXPLICIT_COST"
            ]
          },
          "native_amount": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "asset_id": {
                "type": "string"
              },
              "amount_minor": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$"
              },
              "decimals": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            },
            "required": [
              "asset_id",
              "amount_minor",
              "decimals"
            ]
          },
          "in_start_asset_minor": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "valuation_reference": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "native_amount",
          "in_start_asset_minor",
          "valuation_reference"
        ]
      }
    },
    "quoted_output_includes_pool_fees_and_price_impact": {
      "const": true
    },
    "net_after_explicit_costs_minor": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^-?(0|[1-9][0-9]*)$",
      "description": "Null means unavailable external costs, never zero. Version 1.1 allows a numeric net only when costs_complete is true."
    },
    "simulation_status": {
      "enum": [
        "NOT_RUN",
        "PASSED",
        "FAILED",
        "UNSUPPORTED"
      ]
    },
    "inclusion_scenario_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "finality_status": {
      "enum": [
        "NOT_APPLICABLE",
        "PROVISIONAL",
        "FINALIZED"
      ]
    },
    "transaction_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "eligibility_checks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state_fresh_and_coherent": {
          "type": "boolean"
        },
        "atomic_route_supported": {
          "type": "boolean"
        },
        "final_balance_guard_present": {
          "type": "boolean"
        },
        "costs_complete": {
          "type": "boolean"
        },
        "principal_and_fee_reservations_valid": {
          "type": "boolean"
        },
        "simulation_matches_exact_plan": {
          "type": "boolean"
        }
      },
      "required": [
        "state_fresh_and_coherent",
        "atomic_route_supported",
        "final_balance_guard_present",
        "costs_complete",
        "principal_and_fee_reservations_valid",
        "simulation_matches_exact_plan"
      ]
    },
    "execution_plan_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "dataset_origin": {
      "enum": [
        "SYNTHETIC",
        "MANUALLY_CONSTRUCTED",
        "RECORDED_LIVE"
      ],
      "description": "Required in version 1.1; replaying or capturing manually constructed bytes does not make them recorded live market data."
    }
  },
  "required": [
    "schema_version",
    "source_kind",
    "opportunity_id",
    "session_id",
    "experiment_id",
    "strategy_revision",
    "network_id",
    "mode",
    "evidence_label",
    "observed_at",
    "snapshot",
    "funding_mode",
    "start_asset_id",
    "amount_in_minor",
    "quoted_output_minor",
    "route",
    "costs",
    "quoted_output_includes_pool_fees_and_price_impact",
    "net_after_explicit_costs_minor",
    "simulation_status",
    "inclusion_scenario_id",
    "finality_status",
    "transaction_id",
    "reason_codes",
    "eligibility_checks",
    "execution_plan_digest"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "enum": [
              "OBSERVE",
              "PAPER",
              "REPLAY"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "evidence_label": {
            "enum": [
              "CANDIDATE",
              "SIMULATED",
              "ESTIMATED_EXECUTABLE"
            ]
          },
          "transaction_id": {
            "type": "null"
          },
          "finality_status": {
            "const": "NOT_APPLICABLE"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_label": {
            "const": "ESTIMATED_EXECUTABLE"
          }
        }
      },
      "then": {
        "properties": {
          "simulation_status": {
            "const": "PASSED"
          },
          "inclusion_scenario_id": {
            "type": "string",
            "minLength": 1
          },
          "eligibility_checks": {
            "properties": {
              "state_fresh_and_coherent": {
                "const": true
              },
              "atomic_route_supported": {
                "const": true
              },
              "final_balance_guard_present": {
                "const": true
              },
              "costs_complete": {
                "const": true
              },
              "principal_and_fee_reservations_valid": {
                "const": true
              },
              "simulation_matches_exact_plan": {
                "const": true
              }
            }
          },
          "execution_plan_digest": {
            "type": "string",
            "minLength": 1
          },
          "snapshot": {
            "properties": {
              "consistent": {
                "const": true
              },
              "complete": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_label": {
            "const": "SIMULATED"
          }
        }
      },
      "then": {
        "properties": {
          "simulation_status": {
            "const": "PASSED"
          },
          "execution_plan_digest": {
            "type": "string",
            "minLength": 1
          },
          "snapshot": {
            "properties": {
              "consistent": {
                "const": true
              },
              "complete": {
                "const": true
              }
            }
          },
          "eligibility_checks": {
            "properties": {
              "atomic_route_supported": {
                "const": true
              },
              "simulation_matches_exact_plan": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_label": {
            "const": "REALIZED"
          }
        }
      },
      "then": {
        "properties": {
          "mode": {
            "const": "LIVE"
          },
          "transaction_id": {
            "type": "string",
            "minLength": 1
          },
          "finality_status": {
            "enum": [
              "PROVISIONAL",
              "FINALIZED"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.0.0"
          }
        }
      },
      "then": {
        "properties": {
          "net_after_explicit_costs_minor": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]*)$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.1.0"
          }
        }
      },
      "then": {
        "required": [
          "dataset_origin"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "eligibility_checks": {
                  "properties": {
                    "costs_complete": {
                      "const": false
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "net_after_explicit_costs_minor": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "net_after_explicit_costs_minor": {
                  "type": "string",
                  "pattern": "^-?(0|[1-9][0-9]*)$"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "dataset_origin": {
                  "const": "RECORDED_LIVE"
                }
              }
            },
            "then": {
              "properties": {
                "source_kind": {
                  "const": "CAPTURED_MARKET_DATA"
                }
              }
            },
            "else": {
              "properties": {
                "source_kind": {
                  "const": "SYNTHETIC_FIXTURE"
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "evidence_label": {
            "const": "ESTIMATED_EXECUTABLE"
          }
        }
      },
      "then": {
        "properties": {
          "net_after_explicit_costs_minor": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]*)$"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "dataset_origin"
        ]
      },
      "then": {
        "if": {
          "properties": {
            "dataset_origin": {
              "const": "RECORDED_LIVE"
            }
          }
        },
        "then": {
          "properties": {
            "source_kind": {
              "const": "CAPTURED_MARKET_DATA"
            }
          }
        },
        "else": {
          "properties": {
            "source_kind": {
              "const": "SYNTHETIC_FIXTURE"
            }
          }
        }
      }
    }
  ]
}
